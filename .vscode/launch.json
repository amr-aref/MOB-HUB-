{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API Server (ts-node)",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/artifacts/api-server",
      "runtimeExecutable": "node",
      "args": ["-r", "ts-node/register", "src/index.ts"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Attach to Node",
      "type": "pwa-node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "protocol": "inspector",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Current File",
      "type": "pwa-node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Expo: Start",
      "type": "pwa-node",
      "request": "launch",
      "cwd": "${workspaceFolder}/artifacts/mobile",
      "runtimeExecutable": "pnpm",
      "args": ["expo", "start"],
      "console": "integratedTerminal"
    },
    {
      "name": "React Native - Attach to Packager",
      "type": "reactnative",
      "request": "attach"
    }
  ]
}
