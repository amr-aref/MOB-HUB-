# MOB HUB API — development/production template
NODE_ENV=development
PORT=3000

# Required by @workspace/db (Drizzle). Use a local Postgres URL in development.
# Example: postgresql://user:password@localhost:5432/mobhub
DATABASE_URL=postgresql://user:password@localhost:5432/mobhub

# Required secrets — use random values of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret

# Required in production; comma-separated origins.
CORS_ORIGIN=http://localhost:8081

# Optional JWT lifetime overrides.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------------------
# Mobile (Expo) — optional local overrides
# ---------------------------------------------------------------------------
# Full API origin used by AuthContext + generated client (no trailing slash).
# Defaults to http://localhost:3000 when unset (matches PORT above).
# On a physical device, use your machine LAN IP, e.g. http://192.168.1.10:3000
# EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Metro web proxy target for /api (defaults to 3000).
# API_PROXY_PORT=3000
#
# Expo packager port (defaults to 8081 in artifacts/mobile/scripts/dev.mjs).
# EXPO_PORT=8081
