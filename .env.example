# MOB HUB API — development/production template
NODE_ENV=development
PORT=3000

# Required secrets — use random values of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret

# Required in production; comma-separated origins.
CORS_ORIGIN=http://localhost:8081

# Optional JWT lifetime overrides.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
